array Byte20 [byte; 20];
array Byte32 [byte; 32];
array Uint32 [byte; 4];
array Uint64 [byte; 8];
vector Bytes <byte>;
vector Hashes <Byte32>;
struct AssetSpec { id: Uint32, type_hash: Byte32, }
vector Catalogue <AssetSpec>;
table SettlementBase {
    rollup_script: Bytes,
    config_hash: Byte32,
    bootstrap_outpoint: Bytes,
    bootstrap_capacity: Uint64,
    bootstrap_lock: Bytes,
    bootstrap_state: Bytes,
    governance_lock: Bytes,
    custodian_change_lock: Bytes,
    eth_eoa_codes: Hashes,
    catalogue: Catalogue,
}
table Recipient { address: Byte20, account_id: Uint32, script: Bytes, }
vector Recipients <Recipient>;
table Asset { id: Uint32, script: Bytes, }
vector Assets <Asset>;
struct Payout { output_index: Uint32, recipient_index: Uint32, asset_id: Uint32, }
vector Payouts <Payout>;
struct KV { key: Byte32, value: Byte32, }
vector KVs <KV>;
table NativeTransition {
    version: Uint32,
    recipients: Recipients,
    assets: Assets,
    payouts: Payouts,
    kv_state: KVs,
    proof: Bytes,
}

// Settlement v3: record tags are fixed by records.rs and checked after Molecule layout validation.
struct SettlementSource { tag: Uint32, account: Uint32, script_hash: Byte32, address: Byte20, asset: Uint32, type_hash: Byte32, baseline: Byte32, evidence: Byte32, }
struct SettlementLot { tag: Uint32, id: Byte32, source: Byte32, kind: byte, amount: Byte32, evidence: Byte32, reopen: Byte32, }
struct SettlementReserve { tag: Uint32, remaining: Byte32, }
struct SettlementClaim { tag: Uint32, epoch: Uint64, source: Byte32, lot: Byte32, recipient: Uint32, script_hash: Byte32, address: Byte20, cap: Byte32, evidence: Byte32, }
struct SettlementSourceBudget { tag: Uint32, paid: Byte32, }
struct SettlementAssetLimit { tag: Uint32, asset: Uint32, type_hash: Byte32, ceiling: Byte32, }
struct SettlementAssetBudget { tag: Uint32, paid: Byte32, }
struct SettlementEpoch { tag: Uint32, id: Uint64, claim_count: Uint64, manifest: Byte32, policy: Byte32, status: byte, }
struct SettlementPaid { tag: Uint32, amount: Byte32, }
struct SettlementPayment { tag: Uint32, claim: SettlementClaim, amount: Byte32, }
struct SettlementMetadata { tag: Uint32, deployment: Byte32, profile: Byte32, snapshot: Byte32, sequence: Uint64, state_root: Byte32, }
vector SettlementRecords <Bytes>;
table SettlementLeaf { key: Byte32, record: Bytes, }
vector SettlementLeaves <SettlementLeaf>;
table SettlementProof { kind: Uint32, leaves: SettlementLeaves, proof: Bytes, }
vector SettlementProofs <SettlementProof>;
table SettlementAction {
 version: Uint32, operation: Uint32, epoch: Uint64,
 before: Bytes, after: Bytes, records: SettlementRecords,
 trees: SettlementProofs, native: Bytes,
}
table SettlementProfile {
 version: Uint32, base: Bytes, deployment: Byte32, manifest: Byte32,
 state_root: Byte32, source_count: Uint64, reserve_count: Uint64,
 initial_epoch: Bytes, limits: SettlementRecords,
}
